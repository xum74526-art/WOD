# H5 development proxy target.
KAI_H5_API_TARGET=http://127.0.0.1:8100

# Native App API base. Production builds must use an HTTPS endpoint.
VITE_KAI_API_BASE=https://api.example.com/api/v1

# iOS distribution policy. Public App Store builds default to a companion
# experience without external recharge or direct digital-service purchasing.
# Use enterprise only for an authorized private/internal distribution.
VITE_KAI_IOS_DISTRIBUTION=app-store
