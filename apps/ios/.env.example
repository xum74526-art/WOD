# H5 development proxy target.
KAI_H5_API_TARGET=https://wod.kai.com

# Native App API base. Production builds must use an HTTPS endpoint.
VITE_KAI_APP_API_BASE=https://wod.kai.com/api

# App-store review builds must keep this false. Direct transaction UI is
# exposed only when this build gate and the server capability are both true.
VITE_ENABLE_DIRECT_TRADE=false
