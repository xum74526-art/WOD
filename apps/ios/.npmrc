registry=https://registry.npmjs.org/
# DCloud's 2026 compiler still declares an exact Vite 5.2.8 peer although its
# build works with Vite 6.4.3. Keep the security-patched Vite release and remove
# this exception when @dcloudio/vite-plugin-uni accepts Vite 6 natively.
legacy-peer-deps=true
# Install the shared, patched braces source as a package, not a symlink.
install-links=true
