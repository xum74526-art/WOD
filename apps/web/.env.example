# Canonical KAI API. Keep this server-only; never expose the JWT or
# backend origin through a NEXT_PUBLIC_* variable.
API_ORIGIN=https://wod.kai.com
# Keep false in production. Set true only in .env.local for an RFC1918 LAN API.
API_ALLOW_INSECURE_HTTP=false
# Canonical browser origin used for OAuth callbacks behind a reverse proxy.
WEB_PUBLIC_ORIGIN=https://wod.kai.com
NEXT_PUBLIC_KAI_ANDROID_APK_URL=
NEXT_PUBLIC_MARKET_STATUS=unconfigured
