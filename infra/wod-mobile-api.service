[Unit]
Description=WOD shared mobile backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wod/services/mobile-api
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/wod/runtime/mobile-api.env
ExecStartPre=/home/ubuntu/wod/services/mobile-api/.venv/bin/python init_db.py
ExecStart=/home/ubuntu/wod/services/mobile-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/wod/runtime

[Install]
WantedBy=multi-user.target
