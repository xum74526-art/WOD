# Server-only environment for infra/kai-api.service.
SECRET_KEY=
SENSITIVE_DATA_KEY=
DATABASE_URL=sqlite:////home/ubuntu/wod/runtime/data/wod.db
UPLOAD_ROOT=/home/ubuntu/wod/runtime/data/uploads
CORS_ORIGINS=https://wod.kai.com

KAI_AUTH_ISSUER=https://auth.kai.com/api/auth
KAI_AUTH_CLIENT_ID=
KAI_AUTH_CLIENT_SECRET=
KAI_AUTH_CALLBACK_URL=
KAI_AUTH_APP_RETURN_URL=
KAI_AUTH_ALLOWED_RETURN_URLS=

PAYMENT_SERVICE_ENABLED=false
QIXIANGPAY_ENABLED=true
QIXIANGPAY_BASE_URL=https://api.payqixiang.cn
QIXIANGPAY_PID=
QIXIANGPAY_KEY=
QIXIANGPAY_NOTIFY_URL=https://wod.kai.com/api/payments/qixiang/notify
QIXIANGPAY_RETURN_URL=https://wod.kai.com/account/wallet
QIXIANGPAY_PAYMENT_TYPES=alipay,wxpay

MARKET_HISTORY_SYNC_ENABLED=true
COMMUNITY_ONLINE_ENABLED=true
