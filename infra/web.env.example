# SHA-256 only after the signed com.kai.ztwstarmap APK has been produced and
# verified; never reuse the legacy com.kai.wod artifact metadata.
NEXT_PUBLIC_KAI_ANDROID_APK_URL=/download/suanlixingtu.apk
NEXT_PUBLIC_KAI_ANDROID_APK_SIZE=
NEXT_PUBLIC_KAI_ANDROID_APK_SHA256=
