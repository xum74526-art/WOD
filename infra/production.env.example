# Copy to infra/production.env and replace every example value before launch.
KAI_DOMAIN=kai.example.com
ACME_EMAIL=admin@example.com
KAI_IMAGE_TAG=2026.08.20

POSTGRES_DB=wod_web
POSTGRES_USER=wod_web
POSTGRES_PASSWORD_FILE_PATH=./secrets/runtime/postgres_password
REDIS_PASSWORD_FILE_PATH=./secrets/runtime/redis_password
APP_SECRET_KEY_FILE_PATH=./secrets/runtime/app_secret_key
PAYOUT_ENCRYPTION_KEY_FILE_PATH=./secrets/runtime/payout_encryption_key
KYC_ENCRYPTION_KEY_FILE_PATH=./secrets/runtime/kyc_encryption_key
PINGXX_MERCHANT_PRIVATE_KEY_FILE_PATH=./secrets/runtime/pingxx_merchant_private_key.pem
PINGXX_PUBLIC_KEY_FILE_PATH=./secrets/runtime/pingxx_public_key.pem
PINGXX_API_KEY_FILE_PATH=./secrets/runtime/pingxx_api_key
SMTP_PASSWORD_FILE_PATH=./secrets/runtime/smtp_password

PAYMENT_PROVIDER_ENABLED=true
PAYMENT_PROVIDER=pingxx
PINGXX_API_BASE_URL=https://api.pingxx.com
PINGXX_APP_ID=
PINGXX_LIVE_MODE=true
PINGXX_REQUEST_SIGNING_ENABLED=true
PINGXX_DEFAULT_CHANNEL=alipay_pc_direct

EMAIL_VERIFICATION_ENABLED=true
EMAIL_NOTIFICATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

NEWS_SYNC_ENABLED=false
MARKET_SNAPSHOT_ENABLED=false
MARKET_SNAPSHOT_INTERVAL_MINUTES=60
GETDEPLOYING_API_BASE_URL=https://getdeploying.com/api
NEXT_PUBLIC_MARKET_STATUS=unconfigured
PLATFORM_COMMISSION_RATE=0.05
SETTLEMENT_HOLD_HOURS=24
LOG_LEVEL=INFO
