# Safe example values for local Docker acceptance only. Never use in production.
KAI_DOMAIN=localhost
ACME_EMAIL=local@example.com
KAI_IMAGE_TAG=local

POSTGRES_DB=kai_local
POSTGRES_USER=kai
POSTGRES_PASSWORD_FILE_PATH=./secrets/examples/postgres_password
REDIS_PASSWORD_FILE_PATH=./secrets/examples/redis_password
APP_SECRET_KEY_FILE_PATH=./secrets/examples/app_secret_key
PAYOUT_ENCRYPTION_KEY_FILE_PATH=./secrets/examples/payout_encryption_key
KYC_ENCRYPTION_KEY_FILE_PATH=./secrets/examples/kyc_encryption_key
PINGXX_MERCHANT_PRIVATE_KEY_FILE_PATH=./secrets/examples/pingxx_merchant_private_key.pem
PINGXX_PUBLIC_KEY_FILE_PATH=./secrets/examples/pingxx_public_key.pem
PINGXX_API_KEY_FILE_PATH=./secrets/examples/pingxx_api_key
SMTP_PASSWORD_FILE_PATH=./secrets/examples/smtp_password

PAYMENT_PROVIDER_ENABLED=true
PAYMENT_PROVIDER=pingxx
PINGXX_APP_ID=
PINGXX_LIVE_MODE=false
PINGXX_REQUEST_SIGNING_ENABLED=false
PINGXX_DEFAULT_CHANNEL=alipay_pc_direct
EMAIL_VERIFICATION_ENABLED=false
EMAIL_NOTIFICATION_ENABLED=false
NEWS_SYNC_ENABLED=false
MARKET_SNAPSHOT_ENABLED=false
MARKET_SNAPSHOT_INTERVAL_MINUTES=60
