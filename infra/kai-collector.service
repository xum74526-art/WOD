[Unit]
Description=KAI external market collector
After=network-online.target kai-api.service
Wants=network-online.target
Requires=kai-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wod/services/collector
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/wod/runtime/collector.env
ExecStart=/home/ubuntu/wod/services/collector/.venv/bin/python -m collector run
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
