# Development uses a website-only SQLite file. Production should use the
# independent PostgreSQL database named wod_web.
APP_ENV=development
DATABASE_URL=sqlite:///./wod_web.db
SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://127.0.0.1:9100,http://localhost:9100
COOKIE_SECURE=false
SESSION_TTL_DAYS=14
FRONTEND_BASE_URL=http://127.0.0.1:9100
PUBLIC_API_BASE_URL=http://127.0.0.1:8100
AGENT_PUBLIC_API_BASE_URL=http://127.0.0.1:8100
AGENT_ENROLLMENT_TTL_MINUTES=20
AGENT_HEARTBEAT_OFFLINE_SECONDS=120
AGENT_HARDWARE_STALE_SECONDS=180
AGENT_SERVICE_STALE_SECONDS=90
AGENT_AUTHORIZATION_TIMEOUT_SECONDS=300
AGENT_SIGNATURE_MAX_SKEW_SECONDS=300
AGENT_REQUIRE_MTLS=false
# Required when AGENT_REQUIRE_MTLS=true. The reverse proxy must strip incoming
# fingerprint headers, verify the client certificate, then inject both headers.
AGENT_MTLS_PROXY_SECRET=
# Local development only. Set false before production deployment.
AGENT_LOCAL_SIMULATOR_ENABLED=true
REDIS_URL=redis://127.0.0.1:56379/0
RSSHUB_BASE_URL=http://127.0.0.1:1200
NEWS_SYNC_ENABLED=true
NEWS_SYNC_INTERVAL_MINUTES=30
NEWS_SCHEDULER_STOP_TIMEOUT_SECONDS=25
NEWS_CACHE_TTL_SECONDS=300
MARKET_SNAPSHOT_ENABLED=true
MARKET_SNAPSHOT_INTERVAL_MINUTES=60
MARKET_SNAPSHOT_STOP_TIMEOUT_SECONDS=25
MARKET_SNAPSHOT_HTTP_TIMEOUT_SECONDS=20
MARKET_SNAPSHOT_RETENTION_DAYS=400
GETDEPLOYING_API_BASE_URL=https://getdeploying.com/api
# Requires an active GetDeploying API subscription. Keep secrets out of Git.
GETDEPLOYING_API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json

# External providers stay disabled until real credentials are supplied.
SMS_PROVIDER_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
EMAIL_NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_OUTBOX_POLL_SECONDS=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
PAYMENT_PROVIDER_ENABLED=false
KYC_PROVIDER_ENABLED=false
OBJECT_STORAGE_ENABLED=false
PAYMENT_PROVIDER=disabled
# Ping++ Test mode uses a simulated payment page and never moves real funds.
# Obtain Test Key, App ID and Ping++ public key from the Ping++ dashboard.
PINGXX_API_BASE_URL=https://api.pingxx.com
PINGXX_API_KEY=
PINGXX_APP_ID=
PINGXX_PUBLIC_KEY=
PINGXX_MERCHANT_PRIVATE_KEY=
PINGXX_REQUEST_SIGNING_ENABLED=false
PINGXX_LIVE_MODE=false
PINGXX_DEFAULT_CHANNEL=alipay_pc_direct
PINGXX_HTTP_TIMEOUT_SECONDS=10
# 独立于会话 SECRET_KEY，生产环境至少 32 个随机字符；用于加密商家银行账户。
PAYOUT_ENCRYPTION_KEY=
# 人工 KYC 中的证件号码独立加密密钥，生产环境至少 32 个随机字符。
KYC_ENCRYPTION_KEY=
# 第一版推荐规则：平台佣金 5%，租期结束且无争议后 T+1 转为可提现。
PLATFORM_COMMISSION_RATE=0.05
SETTLEMENT_HOLD_HOURS=24
KYC_PROVIDER=disabled
OBJECT_STORAGE_PROVIDER=disabled
PRIVATE_UPLOAD_MAX_BYTES=20971520
PRIVATE_UPLOAD_TTL_MINUTES=15

# Local-only direct purchase/payment/compute loop. The backend additionally
# requires a localhost database, frontend and request host before enabling it.

# Keep direct publishing enabled until an admin review workflow is available.
BUY_REQUEST_REVIEW_ENABLED=false

KAI_AUTH_ISSUER=https://auth.kai.com/api/auth
KAI_AUTH_CLIENT_ID=
KAI_AUTH_CLIENT_SECRET=
KAI_AUTH_CALLBACK_URL=
