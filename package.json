{
  "name": "kai-unified",
  "version": "0.1.0",
  "private": true,
  "description": "KAI Web and cross-platform Mobile sharing one canonical API",
  "scripts": {
    "test:api": "cd services/api && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "init:api": "cd services/api && .venv/bin/python init_db.py",
    "export:openapi": "services/api/.venv/bin/python packages/api-contracts/export_openapi.py",
    "check:contracts": "node packages/api-contracts/check-mobile-api.mjs",
    "check:web": "npm --prefix apps/web run type-check",
    "build:web": "npm --prefix apps/web run build",
    "check:mobile": "npm --prefix apps/mobile run type-check",
    "test:mobile": "npm --prefix apps/mobile test",
    "build:mobile:h5": "npm --prefix apps/mobile run build:h5",
    "build:mobile:app": "npm --prefix apps/mobile run build:app",
    "check:all": "./tooling/check-all.sh"
  },
  "engines": {
    "node": ">=20.19"
  }
}
