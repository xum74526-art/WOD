{
  "name": "kai-unified",
  "version": "0.1.0",
  "private": true,
  "description": "KAI Web and cross-platform Mobile sharing one canonical API",
  "scripts": {
    "test:api": "cd services/api && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "test:collector": "cd services/collector && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "init:api": "cd services/api && .venv/bin/python init_db.py",
    "export:openapi": "services/api/.venv/bin/python packages/api-contracts/export_openapi.py",
    "check:contracts": "services/api/.venv/bin/python packages/api-contracts/check_openapi.py && node packages/api-contracts/check-mobile-api.mjs && node packages/api-contracts/check-client-boundaries.mjs && node packages/api-contracts/check-client-experience-parity.mjs",
    "check:experience-parity": "node packages/api-contracts/check-client-experience-parity.mjs",
    "check:web": "npm --prefix apps/web run type-check",
    "test:web:e2e": "npm --prefix apps/web run e2e",
    "build:web": "npm --prefix apps/web run build",
    "check:ios": "npm --prefix apps/ios run type-check",
    "test:ios": "npm --prefix apps/ios test",
    "build:ios:app": "npm --prefix apps/ios run build:app",
    "check:android": "npm --prefix apps/android run type-check",
    "test:android": "npm --prefix apps/android test",
    "build:android:app": "npm --prefix apps/android run build:android",
    "check:mobile": "npm run check:ios && npm run check:android",
    "test:mobile": "npm run test:ios && npm run test:android",
    "build:mobile:app": "npm run build:ios:app && npm run build:android:app",
    "test:static-review": "node --test static-review/site.test.mjs",
    "check:all": "./tooling/check-all.sh",
    "audit:deps": "./tooling/audit-dependencies.sh"
  },
  "engines": {
    "node": ">=20.19"
  }
}
