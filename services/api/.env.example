# Required closed-test deployment settings. Use a long random SECRET_KEY and a
# persistent SQLite path/host upload directory; never commit real values.
SECRET_KEY=
SENSITIVE_DATA_KEY=
DATABASE_URL=sqlite:////data/wod.db
UPLOAD_ROOT=/data/uploads
CORS_ORIGINS=http://localhost:9000

# Kai OAuth 2.1 / OpenID Connect
# Obtain the client credentials from the Kai authentication administrator.
KAI_AUTH_ISSUER=
KAI_AUTH_CLIENT_ID=
KAI_AUTH_CLIENT_SECRET=

# Public HTTPS endpoint registered in Kai. It must point to this backend route.
KAI_AUTH_CALLBACK_URL=

# H5 example: https://app.example.com/pages/login/index
# Native App example: a verified universal link or registered custom URL scheme.
KAI_AUTH_APP_RETURN_URL=

# Additional exact return URLs for other official clients. Example:
# https://web.example.com/login,wod://pages/login/index
KAI_AUTH_ALLOWED_RETURN_URLS=

KAI_AUTH_SCOPES=openid profile email
KAI_AUTH_FLOW_TTL_SECONDS=600
KAI_AUTH_TICKET_TTL_SECONDS=120
KAI_AUTH_HTTP_TIMEOUT=10

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable after deployment or encrypted ID/card/SSH data cannot be read.
# The test container uses /data/uploads; bind /data to a persistent host
# directory when deploying.
ID_PHOTO_MAX_BYTES=5242880
# Local OCR compares submitted text with the uploaded ID-card images. It is
# only a pre-check; an authorized operator must still approve every identity.
# Enable only on a server image that includes tesseract chi_sim + eng data.
ID_OCR_ENABLED=false
ID_OCR_TESSERACT_CMD=tesseract
ID_OCR_LANGUAGES=chi_sim+eng
ID_OCR_TIMEOUT_SECONDS=10
ID_OCR_QUEUE_TIMEOUT_SECONDS=2
ID_OCR_MAX_CONCURRENCY=2
ID_OCR_MAX_PIXELS=20000000
ID_OCR_MAX_OUTPUT_CHARS=50000
AVATAR_MAX_BYTES=2097152

# Keep false until a real payment and settlement provider is connected.
PAYMENT_SERVICE_ENABLED=false
# Wallet recharge through MaPay V2. Keep both switches false until the RSA
# keys are installed and the 0.01 CNY end-to-end test has passed.
MAPAY_ENABLED=false
MAPAY_BASE_URL=https://mzf.mapay.cc/xpay/epayn
MAPAY_PID=
MAPAY_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/mapay_merchant_private.pem
MAPAY_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/mapay_platform_public.pem
MAPAY_NOTIFY_URL=https://api.example.com/api/payments/mapay/notify
MAPAY_PUBLIC_API_BASE_URL=https://api.example.com/api
# Comma-separated provider channels that this merchant account has actually
# enabled, for example wxpay or alipay,wxpay. Empty disables MaPay checkout.
MAPAY_PAYMENT_TYPES=
MAPAY_HTTP_TIMEOUT=10
MAPAY_CHECKOUT_TTL_SECONDS=300
MAPAY_PROVIDER_TIMEZONE=Asia/Shanghai
MAPAY_MIN_AMOUNT_CNY=0.01
MAPAY_MAX_AMOUNT_CNY=50000
CARD_HOUR_RMB_RATE=1.002

# QiXiang Pay collection gateway (https://qixiangpay.cn/doc_old.html).
# Keep disabled until both public HTTPS URLs are deployed and the enabled
# channels have passed a provider-side 0.01 CNY test.
QIXIANGPAY_ENABLED=false
QIXIANGPAY_BASE_URL=https://api.payqixiang.cn
QIXIANGPAY_PID=
QIXIANGPAY_KEY=
QIXIANGPAY_NOTIFY_URL=https://api.example.com/api/payments/qixiang/notify
QIXIANGPAY_RETURN_URL=https://app.example.com/account/wallet
QIXIANGPAY_PAYMENT_TYPES=
QIXIANGPAY_DEVICE=jump
QIXIANGPAY_HTTP_TIMEOUT=10
QIXIANGPAY_CHECKOUT_TTL_SECONDS=300
QIXIANGPAY_MIN_AMOUNT_CNY=0.01
QIXIANGPAY_MAX_AMOUNT_CNY=50000

# MaPay is collection-only. These capabilities need separate providers and
# must remain false when wallet recharge is enabled.
# Closed-test manual workflow. This records a card for human review and creates
# a withdrawal application only; it never calls a bank or claims four-factor
# verification. Assign finance users explicitly before enabling it.
MANUAL_BANK_CARD_ENABLED=false
MANUAL_PAYOUT_ENABLED=false
FINANCE_ADMIN_USER_IDS=
PAYOUT_CARD_HOUR_RMB_RATE=1.002
PAYOUT_FEE_RATE=0
PAYOUT_MIN_CARD_HOURS=1
PAYOUT_MAX_CARD_HOURS=100000
PAYOUT_RECEIPT_MAX_BYTES=5242880
PAYOUT_INSTRUCTION_REVEAL_TTL_SECONDS=300
REVENUE_SETTLEMENT_ENABLED=false
REWARD_SERVICE_ENABLED=false
# Optional closed-test card-hour rebate program. Credits are generated only
# from confirmed delivered orders and remain nonwithdrawable.
CLOSED_TEST_REWARD_ENABLED=false
# First-party inbox is always available. Leave native system push disabled
# until a real provider (for example UniPush 2.0) and credentials are supplied.
PUSH_SERVICE_ENABLED=false
PUSH_PROVIDER=

# GPU market collectors. Keep credentials only in the server-side env file;
# never bake them into an image or expose them to the App bundle.
VAST_API_KEY=
VAST_API_BASE_URL=https://console.vast.ai/api/v0
AUTODL_TOKEN=
AUTODL_API_BASE_URL=https://api.autodl.com
MARKET_SYNC_SECONDS=10
VAST_MARKET_REFRESH_SECONDS=30
AUTODL_MARKET_REFRESH_SECONDS=60
WOD_MARKET_REFRESH_SECONDS=10
MARKET_HISTORY_DAYS=30
MARKET_UNCHANGED_SNAPSHOT_SECONDS=3600
MARKET_HISTORY_SYNC_ENABLED=true
MARKET_HISTORY_REFRESH_SECONDS=21600
MARKET_HISTORY_BACKFILL_DAYS=10
MARKET_HISTORY_HTTP_TIMEOUT=20
MARKET_HISTORY_CACHE_ROOT=
MARKET_HISTORY_MAX_FILE_BYTES=5242880
MARKET_HISTORY_MAX_REFRESH_BYTES=26214400
MARKET_HISTORY_MIN_EXTERNAL_SAMPLES_PER_DAY=3
MARKET_HISTORY_HF_DATASET=afhubbard/gpu-prices
MARKET_HISTORY_HF_LICENSE=CC BY 4.0
PRODUCT_OFFER_MAX_AGE_SECONDS=900
# Comma-separated WOD user IDs permitted to enter SSH delivery details for
# Vast.ai/AutoDL closed-test orders. Keep empty until an operator is assigned.
PLATFORM_FULFILLMENT_USER_IDS=
FX_API_URL=https://api.frankfurter.dev/v2/rate/USD/CNY?providers=ECB
FX_REFRESH_SECONDS=21600

# Optional OpenAI-compatible support model. Leave AI_PROVIDER/AI_API_KEY empty
# to use the built-in bilingual FAQ and durable ticket service only.
# Supported value today: openai_compatible (DeepSeek-compatible APIs also work).
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_HTTP_TIMEOUT=20
