# Required in every environment. Generate SECRET_KEY and SENSITIVE_DATA_KEY
# independently, store them in the private secret store, and keep both stable
# for the lifetime of persisted data. Never commit, casually rotate, or lose
# either key; key rotation requires an explicit audited re-encryption migration.
SECRET_KEY=
SENSITIVE_DATA_KEY=
DATABASE_URL=sqlite:////data/wod.db
UPLOAD_ROOT=/data/uploads
CORS_ORIGINS=http://localhost:9000,http://localhost:9001,http://localhost:9100
# Stable public-client identifiers used for audit attribution. They are not
# secrets and must never be used as an authorization boundary.
AUTH_CLIENT_PLATFORM_MAP=web=web,ios=ios,android=android,admin=admin

# Native app update metadata. Publish the package first, then change these
# values so installed clients never receive a broken update link. The legacy
# Android channel must continue pointing at com.kai.wod; a different package
# cannot replace it in place.
APP_ANDROID_APPLICATION_ID=com.kai.ztwstarmap
APP_ANDROID_RELEASE_ENABLED=false
APP_ANDROID_LATEST_VERSION_NAME=1.2.1
APP_ANDROID_LATEST_VERSION_CODE=121
APP_ANDROID_UPDATE_URL=https://wod.kai.com/download/suanlixingtu.apk
APP_ANDROID_RELEASE_NOTES_ZH=
APP_ANDROID_RELEASE_NOTES_EN=
APP_ANDROID_LEGACY_APPLICATION_ID=com.kai.wod
APP_ANDROID_LEGACY_RELEASE_ENABLED=true
APP_ANDROID_LEGACY_LATEST_VERSION_NAME=1.2.1
APP_ANDROID_LEGACY_LATEST_VERSION_CODE=121
APP_ANDROID_LEGACY_UPDATE_URL=https://wod.kai.com/download/wod.apk
APP_ANDROID_LEGACY_RELEASE_NOTES_ZH=
APP_ANDROID_LEGACY_RELEASE_NOTES_EN=
APP_IOS_APPLICATION_ID=com.kai.ztwstarmap
APP_IOS_RELEASE_ENABLED=false
APP_IOS_LATEST_VERSION_NAME=
APP_IOS_LATEST_VERSION_CODE=0
APP_IOS_UPDATE_URL=
APP_IOS_RELEASE_NOTES_ZH=
APP_IOS_RELEASE_NOTES_EN=
APP_IOS_LEGACY_APPLICATION_ID=com.kai.wod
APP_IOS_LEGACY_RELEASE_ENABLED=false
APP_IOS_LEGACY_LATEST_VERSION_NAME=
APP_IOS_LEGACY_LATEST_VERSION_CODE=0
APP_IOS_LEGACY_UPDATE_URL=
APP_IOS_LEGACY_RELEASE_NOTES_ZH=
APP_IOS_LEGACY_RELEASE_NOTES_EN=

# KAI星算 account-recovery email. Keep disabled until the sending domain has
# SPF/DKIM/DMARC and all SMTP values below are present in the private env.
ACCOUNT_RECOVERY_EMAIL_ENABLED=false
ACCOUNT_RECOVERY_PUBLIC_WEB_ORIGIN=https://wod.kai.com
ACCOUNT_RECOVERY_VERIFY_TTL_SECONDS=1800
ACCOUNT_RECOVERY_RESET_TTL_SECONDS=1800
ACCOUNT_RECOVERY_KAI_TTL_SECONDS=600
ACCOUNT_RECOVERY_SMTP_HOST=
ACCOUNT_RECOVERY_SMTP_PORT=587
ACCOUNT_RECOVERY_SMTP_USERNAME=
ACCOUNT_RECOVERY_SMTP_PASSWORD=
ACCOUNT_RECOVERY_SMTP_FROM=
ACCOUNT_RECOVERY_SMTP_STARTTLS=true
ACCOUNT_RECOVERY_SMTP_SSL=false
ACCOUNT_RECOVERY_SMTP_TIMEOUT_SECONDS=10
ACCOUNT_RECOVERY_MAIL_WORKER_SECONDS=10
ACCOUNT_RECOVERY_MAIL_BATCH_SIZE=10
ACCOUNT_RECOVERY_MAIL_MAX_ATTEMPTS=5
ACCOUNT_RECOVERY_MAIL_RETRY_BASE_SECONDS=30
ACCOUNT_RECOVERY_MAIL_RETRY_MAX_SECONDS=900
ACCOUNT_RECOVERY_MAIL_LEASE_SECONDS=120
ACCOUNT_RECOVERY_MAIL_RETENTION_SECONDS=86400

# Kai OAuth 2.1 / OpenID Connect
# Obtain the client credentials from the Kai authentication administrator.
# The issuer must match the signed `iss` value exactly; endpoint paths belong
# in KAI_AUTH_ENDPOINT_BASE instead of being appended to the issuer.
KAI_AUTH_ISSUER=https://auth.kai.com
KAI_AUTH_ENDPOINT_BASE=https://auth.kai.com/api/auth
KAI_AUTH_CLIENT_ID=
KAI_AUTH_CLIENT_SECRET=

# Public HTTPS endpoint registered in Kai. It must point to this backend route.
KAI_AUTH_CALLBACK_URL=https://wod.kai.com/api/auth/kai/callback

# H5 example: https://app.example.com/pages/login/index
# Native App example: a verified universal link or registered custom URL scheme.
# The official app keeps kai://auth during the package rename; do not replace
# it unless both Kai's registered redirect configuration and both clients move
# in the same release.
KAI_AUTH_APP_RETURN_URL=kai://auth

# Additional exact return URLs for other official clients. Example:
# login, account recovery, account settings binding, and native App return.
KAI_AUTH_ALLOWED_RETURN_URLS=https://wod.kai.com/login,https://wod.kai.com/reset-password,https://wod.kai.com/account-deletion,https://wod.kai.com/account/settings,kai://auth

KAI_AUTH_SCOPES=openid profile email
KAI_AUTH_FLOW_TTL_SECONDS=600
KAI_AUTH_TICKET_TTL_SECONDS=120
KAI_AUTH_REAUTH_MAX_AGE_SECONDS=600
KAI_AUTH_HTTP_TIMEOUT=10

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable after deployment or encrypted ID/card/SSH data cannot be read.
# The test container uses /data/uploads; bind /data to a persistent host
# directory when deploying.
ID_PHOTO_MAX_BYTES=5242880
# Local OCR compares submitted text with the uploaded ID-card images. It is
# only a pre-check; an authorized operator must still approve every identity.
# Enable only on a server image that includes tesseract chi_sim + eng data.
ID_OCR_ENABLED=false
ID_OCR_TESSERACT_CMD=tesseract
ID_OCR_LANGUAGES=chi_sim+eng
ID_OCR_TIMEOUT_SECONDS=10
ID_OCR_QUEUE_TIMEOUT_SECONDS=2
ID_OCR_MAX_CONCURRENCY=2
ID_OCR_MAX_PIXELS=20000000
ID_OCR_MAX_OUTPUT_CHARS=50000
AVATAR_MAX_BYTES=2097152
# First review release: text-only UGC until image/video moderation is ready.
COMMUNITY_USER_MEDIA_ENABLED=false
COMMUNITY_IMAGE_MAX_BYTES=5242880
COMMUNITY_VIDEO_MAX_BYTES=20971520
COMMUNITY_VIDEO_MAX_DURATION_SECONDS=300
COMMUNITY_VIDEO_TRANSCODE_TIMEOUT_SECONDS=180
COMMUNITY_VIDEO_TRANSCODE_CONCURRENCY=1

# First public review release: expose only KAI-operated catalogue rows. Keep
# false until third-party merchant listings have moderation and reporting.
THIRD_PARTY_MERCHANT_PUBLIC_CATALOG_ENABLED=false

# Inquiry-only launch mode. Enable only after qualifications and the full
# transaction workflow are ready.
DIRECT_TRADE_ENABLED=false
# Enables KAI-operated holding purchases and CNY wallet buyback settlement.
# This does not enable holding trades for merchant-declared listings.
HOLDING_TRADE_ENABLED=false
# Demand submission and supplier quotations remain available without wallet,
# recharge, withdrawal or an automatic transaction commitment.
MATCHMAKING_ENABLED=true
MATCHMAKING_CREDENTIAL_ESCROW_ENABLED=true
# Keep false until a real payment and settlement provider is connected.
PAYMENT_SERVICE_ENABLED=false
# MaPay is retired for new collection. Keep MAPAY_ENABLED=false. The separate
# legacy switch permits only historical callback/query close-out after its RSA
# keys have been installed and verified.
MAPAY_ENABLED=false
MAPAY_LEGACY_RECONCILIATION_ENABLED=false
MAPAY_BASE_URL=https://mzf.mapay.cc/xpay/epayn
MAPAY_PID=
MAPAY_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/mapay_merchant_private.pem
MAPAY_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/mapay_platform_public.pem
MAPAY_NOTIFY_URL=https://api.example.com/api/payments/mapay/notify
MAPAY_PUBLIC_API_BASE_URL=https://api.example.com/api
# Comma-separated provider channels that this merchant account has actually
# enabled, for example wxpay or alipay,wxpay. Empty disables MaPay checkout.
MAPAY_PAYMENT_TYPES=
MAPAY_HTTP_TIMEOUT=10
MAPAY_CHECKOUT_TTL_SECONDS=300
MAPAY_PROVIDER_TIMEZONE=Asia/Shanghai
MAPAY_MIN_AMOUNT_CNY=10
MAPAY_MAX_AMOUNT_CNY=50000
# Deprecated compatibility input. Direct-money settlement is always 1:1 and
# runtime services do not use this value as an exchange rate.
CARD_HOUR_RMB_RATE=1.0
# Display-only HKD/USD reference rates are synchronized daily from the ECB and
# returned by /api/platform/capabilities. Settlement remains in CNY.

# QiXiang Pay collection gateway (https://qixiangpay.cn/doc_old.html).
# Keep disabled until both public HTTPS URLs are deployed and the enabled
# channels have passed a provider-side minimum-amount check.
QIXIANGPAY_ENABLED=false
# Refund is a separate merchant-console permission and remains off until an
# authorized same-day refund test and finance SOP have passed.
QIXIANGPAY_REFUND_ENABLED=false
QIXIANGPAY_BASE_URL=https://api.payqixiang.cn
QIXIANGPAY_PID=
QIXIANGPAY_KEY=
# These three first-party URLs are pinned by startup readiness and by both
# native clients. Do not substitute another host without a coordinated release.
QIXIANGPAY_NOTIFY_URL=https://wod.kai.com/api/payments/qixiang/notify
QIXIANGPAY_RETURN_URL=https://wod.kai.com/payment/qixiang/return
QIXIANGPAY_PUBLIC_API_BASE_URL=https://wod.kai.com/api
QIXIANGPAY_PAYMENT_TYPES=
QIXIANGPAY_DEVICE=jump
PAYMENT_CHECKOUT_ALLOWED_HOSTS=api.payqixiang.cn
QIXIANGPAY_HTTP_TIMEOUT=10
QIXIANGPAY_MAX_RESPONSE_BYTES=262144
QIXIANGPAY_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
QIXIANGPAY_CHECKOUT_TTL_SECONDS=300
QIXIANGPAY_PROVIDER_TIMEZONE=Asia/Shanghai
QIXIANGPAY_MIN_AMOUNT_CNY=10
QIXIANGPAY_MAX_AMOUNT_CNY=40000
PAYMENT_MAX_PENDING_ORDERS_PER_USER=5
PAYMENT_DAILY_RECHARGE_LIMIT_CNY=10000000
# Bounded active order reconciliation. Enable only after provider query tests.
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=20
PAYMENT_RECONCILIATION_MIN_AGE_SECONDS=30
PAYMENT_RECONCILIATION_MAX_AGE_SECONDS=604800
PAYMENT_REFUND_SUBMISSION_TIMEOUT_SECONDS=300

# Bank-card intake and payout need separate controls and never follow collection.
# Closed-test manual workflow. This records a card for human review and creates
# a withdrawal application only; it never calls a bank or claims four-factor
# verification. Every review and payout action requires the platform admin role.
MANUAL_BANK_CARD_ENABLED=false
MANUAL_PAYOUT_ENABLED=false
# Deprecated compatibility input; withdrawals are direct CNY money at 1:1.
PAYOUT_CARD_HOUR_RMB_RATE=1.0
PAYOUT_FEE_RATE=0
PAYOUT_MIN_CARD_HOURS=10
PAYOUT_MAX_CARD_HOURS=100000
PAYOUT_RECEIPT_MAX_BYTES=5242880
PAYOUT_INSTRUCTION_REVEAL_TTL_SECONDS=300
# Confirmed merchant sale income is withdrawable; all reward balances remain
# consumption-only. 1000 basis points = a 10% platform service fee.
MERCHANT_SERVICE_FEE_BPS=1000
ORDER_DELIVERY_TIMEOUT_HOURS=24
ORDER_CONFIRMATION_TIMEOUT_HOURS=24
ORDER_DISPUTE_REVIEW_TIMEOUT_HOURS=72
ORDER_LEGACY_PENDING_MIGRATION_ENABLED=false
REVENUE_SETTLEMENT_ENABLED=false
REWARD_SERVICE_ENABLED=false
# Optional closed-test reward-balance rebate program. Credits are generated only
# from confirmed delivered orders and remain nonwithdrawable.
CLOSED_TEST_REWARD_ENABLED=false
# Independent, versioned reward writers. Keep the two legacy switches above
# disabled; enable these only after reward_accruals has been deployed and
# audited. Each switch affects future source events only.
CONSUMER_REWARD_ENABLED=false
SUPPLIER_REWARD_ENABLED=false
INVITE_REWARD_ENABLED=false
# Do not enable together with INVITE_REWARD_ENABLED. V2 grants a fixed CNY reward
# qualification bonus plus tiered commission on recharge-backed consumption.
INVITE_V2_ENABLED=false
# Set true only after reward_accruals and its ledger reference are migrated.
# Turning a program writer off does not erase accrued obligations; this is the
# explicit emergency switch for temporarily pausing their settlement.
REWARD_SETTLEMENT_ENABLED=false
REWARD_TIMEZONE=Asia/Shanghai
# First-party inbox is always available. Leave native system push disabled
# until a real provider (for example UniPush 2.0) and credentials are supplied.
PUSH_SERVICE_ENABLED=false
PUSH_PROVIDER=

# KAI Pricing is the only active market source. It is a public,
# unauthenticated CNY/GPU-hour publication API.
KAI_PRICING_API_BASE_URL=https://pricing.kai.com
KAI_PRICING_REFRESH_SECONDS=300
KAI_PRICING_HTTP_TIMEOUT=10
KAI_PRICING_MAX_RESPONSE_BYTES=2097152
KAI_PRICING_HTTP_KEEPALIVE_SECONDS=30
KAI_PRICING_HTTP_CLEANUP_GRACE=0.75
KAI_PRICING_HTTP_MAX_RETIRED_GENERATIONS=1
KAI_PRICING_HTTP_RESTART_LIMIT=3
KAI_PRICING_HTTP_RESTART_WINDOW_SECONDS=300
KAI_PRICING_HTTP_FAIL_FAST_ENABLED=false
KAI_PRICING_HTTP_FAIL_FAST_SECONDS=30
KAI_CANDLE_HTTP_TIMEOUT=6
KAI_CANDLE_TOTAL_TIMEOUT=15
KAI_CANDLE_MAX_RESPONSE_BYTES=1048576
KAI_CANDLE_MAX_TOTAL_BYTES=6291456
KAI_CANDLE_MAX_PRODUCTS=8
KAI_RANKING_MAX_PRODUCTS=24
KAI_CANDLE_MAX_WORKERS=4
KAI_CANDLE_CACHE_SECONDS=300
KAI_CLOSED_TEST_INITIAL_STOCK=3
# Third-party articles/videos remain disabled until rights evidence is archived.
COMMUNITY_AGGREGATED_CONTENT_ENABLED=false
# Internal collector-to-FastAPI ingestion. Generate a dedicated random token;
# never reuse SECRET_KEY and never expose this endpoint through the public BFF.
MARKET_INGESTION_ENABLED=false
MARKET_INGESTION_TOKEN=
VAST_STALE_SECONDS=1800
VAST_DELETE_AFTER_HOURS=48
VAST_HISTORY_DAYS=90
MARKET_SYNC_SECONDS=10
MARKET_HISTORY_DAYS=30
MARKET_CANDLE_SYNC_SECONDS=300
MARKET_CANDLE_HISTORY_DAYS=100
MARKET_UNCHANGED_SNAPSHOT_SECONDS=300
# Daily ECB reference rates are presentation-only; the ledger/payment base is CNY.
DISPLAY_FX_HTTP_TIMEOUT_SECONDS=10
DISPLAY_FX_MAX_RESPONSE_BYTES=65536
DISPLAY_FX_MAX_REFERENCE_AGE_DAYS=10
DISPLAY_FX_STALE_AFTER_DAYS=7
DISPLAY_FX_RETENTION_DAYS=400
DISPLAY_FX_REFRESH_HOUR=23
DISPLAY_FX_REFRESH_MINUTE=30
PRODUCT_OFFER_MAX_AGE_SECONDS=900
# Comma-separated existing KAI星算 user IDs permitted to enter SSH delivery details
# for KAI self-operated orders. Keep empty until an operator is assigned: KAI
# products intentionally fail closed and remain non-purchasable in that state.
# Set the real IDs only in the private deployment EnvironmentFile; never commit
# an account ID here as a code default.
PLATFORM_FULFILLMENT_USER_IDS=

# Optional OpenAI-compatible support model. Leave AI_PROVIDER/AI_API_KEY empty
# to use the built-in bilingual FAQ and durable ticket service only.
# Supported value today: openai_compatible (DeepSeek-compatible APIs also work).
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_HTTP_TIMEOUT=20
